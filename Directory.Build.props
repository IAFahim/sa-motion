<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SaLibraryFramework)' == 'netstandard2.1'">
    <DefineConstants>$(DefineConstants);SA_LIBRARY_NETSTANDARD</DefineConstants>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(SaLibraryFramework)' != ''">
    <ProjectReference>
      <SetTargetFramework>TargetFramework=$(SaLibraryFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemDefinitionGroup>
</Project>
